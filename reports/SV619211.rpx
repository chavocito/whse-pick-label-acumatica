<?xml version="1.0" encoding="utf-8"?>
<Report version="" Name="ServaItemPickTag">
  <Filters>
    <FilterExp>
      <DataField>ServaLabelPrintRequest.RequestID</DataField>
      <Value>@RequestID</Value>
    </FilterExp>
  </Filters>
  <LayoutUnit>Pixel</LayoutUnit>
  <Parameters>
    <ReportParameter>
      <Name>RequestID</Name>
      <Prompt>Request ID</Prompt>
      <Required>True</Required>
      <DataType>Int32</DataType>
      <Visible>False</Visible>
    </ReportParameter>
  </Parameters>
  <PageSettings>
    <Margins><Bottom>0px</Bottom><Left>0px</Left><Right>0px</Right><Top>0px</Top></Margins>
    <PaperKind>Custom</PaperKind>
    <PaperSize>384px, 288px</PaperSize>
  </PageSettings>
  <Tables>
    <ReportTable Name="ServaLabelPrintRequest">
      <Fields>
        <ReportField Name="RequestID"><DataType>Int32</DataType></ReportField>
        <ReportField Name="ShipmentNbr"></ReportField>
        <ReportField Name="OrderType"></ReportField>
        <ReportField Name="OrderNbr"></ReportField>
        <ReportField Name="LineNbr"><DataType>Int32</DataType></ReportField>
        <ReportField Name="InventoryID"><DataType>Int32</DataType></ReportField>
        <ReportField Name="ItemNumber"></ReportField>
        <ReportField Name="ItemDescription"></ReportField>
        <ReportField Name="SiteID"><DataType>Int32</DataType></ReportField>
        <ReportField Name="SiteName"></ReportField>
        <ReportField Name="LocationID"><DataType>Int32</DataType></ReportField>
        <ReportField Name="LocationCD"></ReportField>
        <ReportField Name="UOM"></ReportField>
        <ReportField Name="PickedQty"><DataType>Decimal</DataType></ReportField>
        <ReportField Name="QuantityPerLabel"><DataType>Decimal</DataType></ReportField>
        <ReportField Name="CountryOfOrigin"></ReportField>
        <ReportField Name="CreatedDateTime"><DataType>DateTime</DataType></ReportField>
      </Fields>
      <FullName>Serva.Acumatica.SoScannerLabels.ServaLabelPrintRequest</FullName>
    </ReportTable>
  </Tables>
  <Sections>
    <PageHeader Name="pageHeaderSection1"><Height>0px</Height></PageHeader>
    <Detail Name="detailSection1">
      <Height>288px</Height>
      <Items>
        <TextBox Name="brand">
          <Location>12px, 10px</Location><Size>70px, 24px</Size>
          <Style><Font><Size>17px</Size><Style>Bold</Style></Font></Style><Value>serva</Value>
        </TextBox>
        <TextBox Name="itemNumber">
          <Location>84px, 6px</Location><Size>205px, 32px</Size>
          <Style><Font><Size>21px</Size><Style>Bold</Style></Font><TextAlign>Center</TextAlign></Style>
          <Value>=[ServaLabelPrintRequest.ItemNumber]</Value>
        </TextBox>
        <TextBox Name="uom">
          <Location>291px, 8px</Location><Size>38px, 24px</Size>
          <Style><Font><Size>12px</Size></Font><TextAlign>Right</TextAlign></Style>
          <Value>=[ServaLabelPrintRequest.UOM]</Value>
        </TextBox>
        <TextBox Name="quantity">
          <Location>332px, 5px</Location><Size>46px, 30px</Size>
          <Style><Font><Size>18px</Size><Style>Bold</Style></Font><TextAlign>Right</TextAlign></Style>
          <Value>=[ServaLabelPrintRequest.QuantityPerLabel]</Value>
        </TextBox>
        <PictureBox Name="itemQr">
          <BarcodeType>QRCode</BarcodeType><Location>12px, 49px</Location><MimeType>image/bmp</MimeType>
          <QRCodeSettings></QRCodeSettings><Size>112px, 112px</Size><Source>Barcode</Source>
          <Value>=[ServaLabelPrintRequest.ItemNumber]</Value>
        </PictureBox>
        <TextBox Name="siteName">
          <Location>132px, 51px</Location><Size>240px, 28px</Size>
          <Style><Font><Size>14px</Size><Style>Bold</Style></Font><TextAlign>Center</TextAlign></Style>
          <Value>=[ServaLabelPrintRequest.SiteName]</Value>
        </TextBox>
        <TextBox Name="description">
          <Location>132px, 84px</Location><Size>240px, 76px</Size>
          <Style><Font><Size>14px</Size></Font><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign></Style>
          <Value>=[ServaLabelPrintRequest.ItemDescription]</Value>
        </TextBox>
        <Line Name="separator"><Location>10px, 172px</Location><Size>366px, 1px</Size></Line>
        <TextBox Name="coo">
          <Location>12px, 182px</Location><Size>110px, 21px</Size><Style><Font><Size>11px</Size></Font></Style>
          <Value>='COO: ' + IsNull([ServaLabelPrintRequest.CountryOfOrigin],'')</Value>
        </TextBox>
        <TextBox Name="printedDate">
          <Location>12px, 209px</Location><Size>110px, 21px</Size><Style><Font><Size>10px</Size></Font></Style>
          <Value>=[ServaLabelPrintRequest.CreatedDateTime]</Value>
        </TextBox>
        <TextBox Name="locationLabel">
          <Location>134px, 181px</Location><Size>108px, 18px</Size>
          <Style><Font><Size>10px</Size></Font><TextAlign>Center</TextAlign></Style><Value>LOC</Value>
        </TextBox>
        <TextBox Name="location">
          <Location>134px, 202px</Location><Size>108px, 28px</Size>
          <Style><Font><Size>14px</Size><Style>Bold</Style></Font><TextAlign>Center</TextAlign></Style>
          <Value>=[ServaLabelPrintRequest.LocationCD]</Value>
        </TextBox>
        <TextBox Name="orderLabel">
          <Location>252px, 181px</Location><Size>124px, 18px</Size>
          <Style><Font><Size>10px</Size></Font><TextAlign>Right</TextAlign></Style><Value>SO#</Value>
        </TextBox>
        <TextBox Name="orderNumber">
          <Location>252px, 202px</Location><Size>124px, 28px</Size>
          <Style><Font><Size>13px</Size><Style>Bold</Style></Font><TextAlign>Right</TextAlign></Style>
          <Value>=[ServaLabelPrintRequest.OrderNbr]</Value>
        </TextBox>
        <TextBox Name="requestTrace">
          <Location>12px, 254px</Location><Size>364px, 18px</Size>
          <Style><Font><Size>8px</Size></Font><TextAlign>Right</TextAlign></Style>
          <Value>='Label request ' + [ServaLabelPrintRequest.RequestID]</Value>
        </TextBox>
      </Items>
    </Detail>
    <PageFooter Name="pageFooterSection1"><Height>0px</Height></PageFooter>
  </Sections>
</Report>
